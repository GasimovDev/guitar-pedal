  (lib_symbols)
  (text "GUITAR EFFECTS PEDAL  -  STM32F411 + PCM1808 ADC + PCM5102A DAC"
    (at 20 20 0)
    (effects
      (font
        (size 4 4))
      (justify left top))
    (uuid "188eced1-2e7c-5c68-9360-3b9e98973d4e"))
  (text "Signal path:  guitar -> INPUT buffer -> ADC (PCM1808) -> I2S -> MCU (overdrive, tremolo, delay) -> I2S -> DAC (PCM5102A) -> OUTPUT buffer -> amp\nEvery wire is drawn as a label: two labels with the same name are the same wire.\nPower: 9 V centre-negative adapter. Net names: +9V (after the protection diode), +5V, +5VA (ADC analog), +3V3A (converters), +3V3_MCU (from the Black Pill), VBIAS (half of 9 V, the op-amps' 'zero')."
    (at 20 30 0)
    (effects
      (font
        (size 1.8 1.8))
      (justify left top))
    (uuid "6f852bf7-4b1d-516d-bc72-c55e593b95c5"))
